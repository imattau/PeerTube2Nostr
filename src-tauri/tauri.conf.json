{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "PeerTube2Nostr",
  "version": "0.2.3",
  "identifier": "com.peertube2nostr.desktop",
  "build": {
    "beforeDevCommand": "cd webapp/frontend && npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "cd webapp/frontend && npm run build",
    "frontendDist": "../webapp/frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PeerTube2Nostr",
        "width": 1280,
        "height": 820,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Video",
    "shortDescription": "Publish PeerTube channel videos to Nostr",
    "homepage": "https://github.com/imattau/PeerTube2Nostr",
    "targets": ["deb", "appimage", "rpm", "msi", "nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libappindicator3-1"],
        "files": {}
      },
      "appimage": {
        "bundleMediaFramework": true
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "libappindicator-gtk3"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
